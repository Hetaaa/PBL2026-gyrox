<?xml version="1.0"?>
<package format="3">
  <name>project_bringup</name>
  <version>0.1.0</version>
  <description>Main system bringup orchestrator with health checks for all subsystems.</description>
  <maintainer email="admin@phoenixslam.com">Phoenix Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>

  <exec_depend>slam_bringup</exec_depend>
  <exec_depend>robot_model</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>scan_filter</exec_depend>
  <exec_depend>ultrasonic_driver</exec_depend>
  <exec_depend>zones_manager</exec_depend>
  <exec_depend>closest_element_info</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
